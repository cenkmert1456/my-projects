<?xml version="1.0" encoding="utf-8"?>
<!--
  DROP animated splash icon (Android 12+ system splash).

  Restrained, one-shot (~500ms):
    1. the whole mark scales from 0.88 → 1.00 with a soft decelerate
    2. the inner dot drops a few pixels and settles

  The static first frame is fully visible, so the AndroidX compat splash on
  older Android renders a visually matching static mark.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_splash_mark">

    <target android:name="markGroup">
        <aapt:attr name="android:animation">
            <set android:ordering="together" android:duration="420">
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.88"
                    android:valueTo="1.0"
                    android:duration="420"
                    android:interpolator="@android:interpolator/decelerate_quint" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.88"
                    android:valueTo="1.0"
                    android:duration="420"
                    android:interpolator="@android:interpolator/decelerate_quint" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="dot">
        <aapt:attr name="android:animation">
            <set android:ordering="together" android:duration="300">
                <objectAnimator
                    android:propertyName="translateY"
                    android:valueFrom="10"
                    android:valueTo="0"
                    android:startOffset="130"
                    android:duration="300"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
                <objectAnimator
                    android:propertyName="alpha"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:startOffset="130"
                    android:duration="260"
                    android:interpolator="@android:interpolator/decelerate_cubic" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
