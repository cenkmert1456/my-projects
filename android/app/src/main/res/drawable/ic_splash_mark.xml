<?xml version="1.0" encoding="utf-8"?>
<!--
  DROP splash mark — a cream droplet outline with a solid inner dot, drawn
  on a 288dp canvas (the Android 12 splash icon surface). The mark sits well
  inside the masked circle's safe zone. Groups are named so the animated
  variant (ic_splash_mark_anim.xml) can scale the whole mark and drop the
  inner dot.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="288dp"
    android:height="288dp"
    android:viewportWidth="288"
    android:viewportHeight="288">

    <group
        android:name="markGroup"
        android:pivotX="144"
        android:pivotY="144"
        android:scaleX="1"
        android:scaleY="1">

        <!-- Droplet outline: from the top point, curving down and around to
             the widest point (y=153), then a semicircular bottom, back up. -->
        <path
            android:name="dropOutline"
            android:pathData="M144,66c26,32 51,56 51,87a51,51 0 0 1 -102,0c0,-31 25,-55 51,-87z"
            android:strokeColor="@color/splash_icon"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000" />

        <!-- Inner dot — sits lower in the droplet; animates a small drop. -->
        <path
            android:name="dot"
            android:pathData="M144,166m-13,0a13,13 0 1 1 26,0a13,13 0 1 1 -26,0"
            android:fillColor="@color/splash_icon" />
    </group>
</vector>
